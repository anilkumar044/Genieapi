{
  "name": "musing-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AWS backend for the Musing iOS app: Sign in with Apple sessions, per-user limits, and Claude on Amazon Bedrock.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check:mock-bedrock": "tsx scripts/mock-bedrock-check.ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.33.8",
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.3",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.271.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
